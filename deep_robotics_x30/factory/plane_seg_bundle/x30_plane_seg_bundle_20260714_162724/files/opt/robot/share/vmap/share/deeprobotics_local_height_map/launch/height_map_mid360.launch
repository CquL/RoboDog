<launch>
    <arg name="robot_type" default="dianli" />
    <!-- 是否打开可视化界面Rviz --> 
    <arg name="enable_rviz" default="false" />
    <!-- 是否打开机器人urdf模型 -->
    <arg name="enable_urdf" default="false" />
    <!-- 是否打开地形图传输程序 -->
    <arg name="enable_gridmap_transformer" default="false" />   <!-- 已转移至transfer -->
    <!-- 是否打开安全停避障 -->
    <arg name="enable_safety" default="true" />
    <!-- 是否计算四边形约束 -->
    <arg name="enable_quadrangels" default="true" />

    <!-- <env name="ROSCONSOLE_CONFIG_FILE" value="$(find deeprobotics_local_height_map)/launch/heightMap.conf"/> -->

    <group if="$(eval arg('robot_type') == 'dianli')">
      <!-- 地形图 -->
      <node pkg="deeprobotics_local_height_map" type="deeprobotics_local_height_map_mid360" name="deeprobotics_local_height_map_mid360" output="screen">
        <rosparam command="load" file="$(find deeprobotics_local_height_map)/config/param_all_mid360.yaml" />
      </node>
      <!-- 发布静态TF变换 -->
      <node pkg="tf2_ros" type="static_transform_publisher" name="base2livoxlidar"   args= "0 0 0 0 0 0 /base_link /livox_frame" />
    </group>

    <include file="$(find deeprobotics_local_height_map)/launch/base_stellar_tf.launch" />

    <group if="$(arg enable_safety)">
      <node pkg="deeprobotics_local_height_map" name="safety_node" type="safety_node" output="screen">
        <rosparam command="load" file="$(find deeprobotics_local_height_map)/config/safety.yaml" />
      </node>
    </group>

    <group if="$(arg enable_quadrangels)">
      <node name="plane_seg" pkg="plane_seg_ros" type="plane_seg_ros"  > 
        <rosparam command="load" file="$(find plane_seg_ros)/config/plane_seg.yaml" />
        <param name = "heightMapTopic"    type ="string"  value="/deeprobotics_local_height_map_mid360/height_map" />
        <param name = "correctMinSize"    type ="int"     value="4" />
        <param name = "sideDistanceThreshold"    type ="double"     value="0.22" />
      </node>
    </group>
    
    <!-- 地形图传输程序 -->
    <group if="$(arg enable_gridmap_transformer)">
      <node pkg="deeprobotics_grid_map_transformer" type="grid_map_transform_app" name="grid_map_transform_app" >
        <param name = "sport_ip"    type ="string"  value="192.168.1.103" />
      </node>
    </group>
    
    <!-- urdf -->
    <group if="$(arg enable_urdf)">
      <node pkg="tf2_ros" type="static_transform_publisher" name="base2urdf" args="0 0 0 0 0 0 /base_link /dummy" />
      <!-- <node pkg="tf2_ros" type="static_transform_publisher" name="base2urdf" args="0 0 0 0 0 0 /base_link_sport /dummy" /> -->
      <!-- <param name="robot_description" textfile="$(find L3)/L3/L3.urdf" /> -->
      <param name="robot_description" textfile="$(find L3)/L3/L3_new.urdf" />
      <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" />
    </group>

    <!-- RVIZ -->
    <group if="$(arg enable_rviz)">
      <node name="rviz" pkg="rviz" type="rviz" args="-d $(find deeprobotics_local_height_map)/rviz/height_map_camera.rviz" />
    </group>

</launch>


